# Live quantum solver (requires root requirements.txt). Leave blank for a saved-results-only demo.
SOLVER_CALLABLE=app.solver_adapter:optimize
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Set to 1 only after building frontend. Use VITE_API_BASE= when building for same-origin (see README).
SERVE_FRONTEND=0
